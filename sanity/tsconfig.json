{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "paths": {
      "@sanity/icons": ["node_modules/@sanity/icons"],
      "@sanity/types": ["node_modules/@sanity/types"],
      "sanity": ["node_modules/sanity"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
